<clickhouse>
    <profiles>
        <default/>
        <grafana>
            <readonly>2</readonly>
        </grafana>
    </profiles>
    <quotas>
        <default/>
    </quotas>
    <users>
        <otel>
            <password_sha256_hex from_env="SYSMON_OTEL_PASSWORD_SHA256"/>
            <profile>default</profile>
            <quota>default</quota>
            <networks>
                <ip>127.0.0.1</ip>
            </networks>
            <grants>
                <query>GRANT ALL ON otel.*</query>
                <query>GRANT ALL ON scratch.*</query>
            </grants>
        </otel>
        <grafana>
            <password_sha256_hex from_env="SYSMON_GRAFANA_PASSWORD_SHA256"/>
            <profile>grafana</profile>
            <quota>default</quota>
            <networks>
                <ip>127.0.0.1</ip>
            </networks>
            <grants>
                <query>GRANT SELECT ON otel.*</query>
            </grants>
        </grafana>
    </users>
</clickhouse>
