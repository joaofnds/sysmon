{
  "title": "mactop",
  "rows": [
    {
      "title": "CPU",
      "panels": [
        {
          "title": "CPU usage by cluster",
          "unit": "%",
          "width": 4,
          "expr": [
            "mactop_cpu_usage_percent",
            "mactop_pcore_usage_percent",
            "mactop_score_usage_percent",
            "mactop_ecore_usage_percent"
          ],
          "alias": ["total", "P cores", "S cores", "E cores"]
        },
        {
          "title": "P cores",
          "unit": "%",
          "width": 4,
          "expr": ["mactop_cpu_core_usage_percent{type=\"p\"}"],
          "alias": ["core {{core}}"]
        },
        {
          "title": "S and E cores",
          "unit": "%",
          "width": 4,
          "expr": ["mactop_cpu_core_usage_percent{type=~\"s|e\"}"],
          "alias": ["{{type}} core {{core}}"]
        }
      ]
    },
    {
      "title": "GPU and power",
      "panels": [
        {
          "title": "GPU usage",
          "unit": "%",
          "width": 4,
          "expr": ["mactop_gpu_usage_percent"],
          "alias": ["GPU"]
        },
        {
          "title": "GPU frequency",
          "unit": "MHz",
          "width": 4,
          "expr": ["mactop_gpu_freq_mhz"],
          "alias": ["GPU"]
        },
        {
          "title": "Power",
          "unit": "W",
          "width": 4,
          "expr": ["mactop_power_watts{component=~\"cpu|gpu|ane|dram|total\"}"],
          "alias": ["{{component}}"]
        }
      ]
    },
    {
      "title": "Thermals",
      "panels": [
        {
          "title": "SoC and GPU temperature",
          "unit": "°C",
          "width": 4,
          "expr": ["mactop_soc_temp_celsius", "mactop_gpu_temp_celsius"],
          "alias": ["SoC", "GPU"]
        },
        {
          "title": "Hottest sensors",
          "unit": "°C",
          "width": 4,
          "expr": ["topk_max(8, mactop_temp_sensor_celsius)"],
          "alias": ["{{name}}"]
        },
        {
          "title": "Thermal state and fans",
          "description": "Thermal state: 0 nominal, 1 moderate, 2 heavy, 3 trapping, 4 sleeping. Fans in RPM.",
          "width": 4,
          "expr": ["mactop_thermal_state", "mactop_fan_rpm"],
          "alias": ["thermal state", "{{fan_name}} RPM"]
        }
      ]
    },
    {
      "title": "Memory, network, disk",
      "panels": [
        {
          "title": "Memory and swap",
          "unit": "GB",
          "width": 4,
          "expr": ["mactop_memory_gb"],
          "alias": ["{{type}}"]
        },
        {
          "title": "Network",
          "unit": "KB/s",
          "width": 4,
          "expr": ["mactop_network_kbytes_per_sec"],
          "alias": ["{{direction}}"]
        },
        {
          "title": "Disk",
          "unit": "KB/s",
          "width": 4,
          "expr": ["mactop_disk_kbytes_per_sec"],
          "alias": ["{{operation}}"]
        }
      ]
    },
    {
      "title": "Battery",
      "panels": [
        {
          "title": "Battery",
          "description": "Charging is 1 while on charger and charging, 0 otherwise.",
          "width": 12,
          "expr": ["mactop_battery_percent", "mactop_battery_charging * 100"],
          "alias": ["charge %", "charging (100 = yes)"]
        }
      ]
    }
  ]
}
