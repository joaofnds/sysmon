#!/bin/sh
set -u
. "$(dirname "$0")/../lib.sh"

for svc in mactop sysmon-procs victoria-metrics; do
  if pid=$(pid_of "$svc"); then
    ps -p "$pid" -o %cpu=,rss= |
      awk -v svc="$svc" -v pid="$pid" '{ printf "%-17s running  pid %-6s cpu %5s%%  rss %4d MB\n", svc, pid, $1, $2 / 1024 }'
  else
    printf '%-17s stopped\n' "$svc"
  fi
done

targets=$(curl -s --max-time 3 http://127.0.0.1:8428/api/v1/targets |
  grep -o '"scrapePool":"[^"]*"\|"health":"[a-z]*"' | cut -d'"' -f4 | paste - -)
if [ -n "$targets" ]; then
  echo "$targets" | awk '{ printf "%-17s scrape %s\n", $1, $2 }'
else
  echo "scrape targets    unknown (victoria-metrics unreachable)"
fi

if [ -d data ]; then
  echo "data size         $(du -sh data | cut -f1)"
fi

docker compose ps --all --format '{{.Service}} {{.State}}' 2>/dev/null |
  awk '$1 != "schema" { printf "%-17s %s\n", $1, $2; n++ } END { if (!n) print "telemetry stack   not running" }'
